# Never commit captured imagery of real people. Scoped to the frame/data dirs so
# legitimate app resources (launcher icons) and design assets are still allowed;
# CI (.github/workflows/ci.yml) backstops stray imagery elsewhere.
bench/frames/*
!bench/frames/README.md
eval/datasets/*
!eval/datasets/README.md
eval/reports/*.jpg
eval/reports/*.jpeg
eval/reports/*.png
# Video is never a legitimate committed asset anywhere in this repo.
*.mp4
*.mkv

# Local config
bench/backends.yaml
*.env
.env

# Models
*.litertlm
*.gguf
*.engine
models/

# Rust
core-rs/target/

# Android (Gradle build outputs, machine-local config, prebuilt native libs)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# tests
tests/__pycache__/
